---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import { copy, type Language } from "../../../config/site";
import { sortPosts } from "../../../utils/blog";

export function getStaticPaths() {
  return ["zh", "en"].map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const posts = sortPosts(await getCollection("blog", ({ data }) => data.lang === lang && !data.draft));
const featuredPosts = posts.filter(({ data }) => data.featured);
const regularPosts = posts.filter(({ data }) => !data.featured);
const base = import.meta.env.BASE_URL;
const languagePrefix = `${lang}/`;
const hrefFor = (id: string) => `${base}${lang}/blog/${id.replace(languagePrefix, "")}/`;
---

<BaseLayout lang={lang} title={copy[lang].allPosts} alternatePath="/blog/">
  <header class="page-heading shell">
    <p class="eyebrow">{copy[lang].blog}</p>
    <h1>{copy[lang].allPosts}</h1>
  </header>

  {featuredPosts.length > 0 && <section class="post-list shell" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="list-heading">{lang === "zh" ? "置顶文章" : "Featured posts"}</h2>
    {featuredPosts.map((post) => (
      <BlogCard title={post.data.title} description={post.data.description} date={post.data.date}
        tags={post.data.tags} href={hrefFor(post.id)} readMore={copy[lang].readMore}
        locale={lang} base={base} featured />
    ))}
  </section>}

  <section class="post-list shell" aria-labelledby="regular-heading">
    <h2 id="regular-heading" class="list-heading">{lang === "zh" ? "普通文章" : "Latest posts"}</h2>
    {posts.length === 0 && <p>{copy[lang].noPosts}</p>}
    {regularPosts.map((post) => (
      <BlogCard
        title={post.data.title}
        description={post.data.description}
        date={post.data.date}
        tags={post.data.tags}
        href={hrefFor(post.id)}
        readMore={copy[lang].readMore}
        locale={lang}
        base={base}
      />
    ))}
  </section>
</BaseLayout>
