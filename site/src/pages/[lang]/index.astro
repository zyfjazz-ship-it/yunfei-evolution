---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { copy, site, type Language } from "../../config/site";
import { sections } from "../../config/sections";
import { sortPostsByDate } from "../../utils/blog";

export function getStaticPaths() {
  return ["zh", "en"].map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const isZh = lang === "zh";
const base = import.meta.env.BASE_URL;
const path = (value: string) => `${base}${value.replace(/^\//, "")}`;
const latestPosts = sortPostsByDate(await getCollection("blog", ({ data }) => data.lang === lang && !data.draft)).slice(0, 3);
const languagePrefix = `${lang}/`;
const hrefFor = (id: string) => path(`${lang}/blog/${id.replace(languagePrefix, "")}/`);
const formatDate = (date: Date) => new Intl.DateTimeFormat(isZh ? "zh-CN" : "en", { month: "short", day: "numeric" }).format(date);
const activeSections = sections.filter((section) => section.id !== "blog" && section.active);
---

<BaseLayout lang={lang} alternatePath="/">
  <header class="home-hero shell">
    <div>
      <p class="kicker">{site.author} · Personal evolution</p>
      <h1>{isZh ? <><span>云非的</span><span>进化论</span></> : site.name}</h1>
      <p class="home-line">{site.description}</p>
      <p class="home-intro">{copy[lang].intro}</p>
    </div>
    <aside>
      <span>{isZh ? "持续进化的方法" : "A method for evolution"}</span>
      <strong>04</strong>
      <ol>
        {(isZh ? ["学习", "实践", "复盘", "进化"] : ["Learn", "Practice", "Reflect", "Evolve"]).map((item) => <li>{item}</li>)}
      </ol>
    </aside>
  </header>

  <section class="home-latest shell" aria-labelledby="latest-posts-title">
    <header class="section-head">
      <div><p class="kicker">Latest writing</p><h2 id="latest-posts-title">{copy[lang].latestPosts}</h2></div>
      <a href={path(`${lang}/blog/`)}>{copy[lang].viewAllPosts} →</a>
    </header>
    {latestPosts.length > 0 ? <div class="latest-grid">
      {latestPosts.map((post, index) => <a class="latest-card" href={hrefFor(post.id)}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <div><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><h3>{post.data.title}</h3><p>{post.data.description}</p><strong>{copy[lang].readMore} →</strong></div>
      </a>)}
    </div> : <p>{copy[lang].noPosts}</p>}
  </section>

  <section class="home-sections shell" aria-labelledby="home-sections-title">
    <header class="section-head">
      <div><p class="kicker">Explore</p><h2 id="home-sections-title">{isZh ? "沿着不同入口，进入同一个成长系统" : "Different entrances to one evolving system"}</h2></div>
      <p>{isZh ? "文章记录思考，公开课整理知识，作品保存长期创造，展示记录实践轨迹。" : "Writing holds ideas, courses organize knowledge, works preserve creation, and the showcase records practice."}</p>
    </header>
    <div class="section-grid-new">
      {activeSections.map((section, index) => <a class="section-entry" href={section.href ? path(`${lang}${section.href}`) : undefined}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <div><p>{section.id}</p><h3>{section.title[lang]}</h3><strong>{section.description[lang]}</strong><b>{isZh ? "进入查看" : "Explore"} →</b></div>
      </a>)}
    </div>
  </section>

  <section class="home-subscribe shell" aria-labelledby="home-subscribe-title">
    <div><p class="kicker">Newsletter</p><h2 id="home-subscribe-title">{isZh ? "订阅云非的进化论" : "Subscribe to Yunfei's Evolution"}</h2><p>{isZh ? "订阅入口已经预留，未来可接入 Newsletter 服务。" : "The subscription entry is ready for a future newsletter service."}</p></div>
    <a href={path(`${lang}/subscribe/`)}>{isZh ? "前往订阅" : "Subscribe"} →</a>
  </section>
</BaseLayout>

<style>
  .home-hero { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr); gap:clamp(2rem,7vw,6rem); align-items:end; padding-block:clamp(5rem,11vw,9rem); }
  .kicker { margin:0 0 .8rem; color:var(--accent); font-size:.76rem; font-weight:850; letter-spacing:.15em; text-transform:uppercase; }
  h1,h2,h3 { font-family:"Songti SC","STSong",Georgia,serif; font-weight:500; }
  h1 { margin:0; font-size:clamp(4rem,10vw,8rem); line-height:.92; }
  h1 span { display:block; }
  .home-line { margin:1.3rem 0 0; font-family:"Songti SC","STSong",Georgia,serif; font-size:clamp(1.35rem,3vw,2rem); }
  .home-intro { max-width:650px; color:var(--muted); }
  .home-hero aside { min-height:300px; padding:2rem; border-radius:24px; background:var(--ink); color:white; }
  .home-hero aside > span { color:#c6c7c1; font-size:.76rem; font-weight:800; letter-spacing:.12em; }
  .home-hero aside strong { display:block; margin:.4rem 0 1.2rem; font:500 6.2rem/1 Georgia,serif; }
  .home-hero ol { display:grid; grid-template-columns:repeat(2,1fr); gap:.45rem 1rem; padding:0; margin:0; list-style:none; color:#d8dad6; font-size:.88rem; }
  .home-hero li::before { content:"— "; color:#7fa897; }
  .home-latest,.home-sections { padding-bottom:clamp(5rem,10vw,8rem); }
  .section-head { display:grid; grid-template-columns:1fr minmax(260px,.55fr); gap:3rem; align-items:end; margin-bottom:2rem; }
  .section-head h2 { max-width:780px; margin:0; font-size:clamp(2.5rem,5.5vw,4.8rem); line-height:1.08; }
  .section-head > a { justify-self:end; color:var(--accent); font-weight:800; }
  .section-head > p { margin:0; color:var(--muted); }
  .latest-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .latest-card { display:grid; grid-template-columns:44px minmax(0,1fr); gap:.8rem; min-height:300px; padding:1.4rem; border:1px solid var(--line); border-radius:18px; background:var(--surface); color:inherit; text-decoration:none; transition:transform .2s ease,box-shadow .2s ease; }
  .latest-card:hover,.latest-card:focus-visible { transform:translateY(-3px); box-shadow:0 18px 45px rgba(32,33,31,.08); outline:none; }
  .latest-card > span { color:var(--accent); font:500 2rem/1 Georgia,serif; }
  .latest-card time { color:var(--muted); font-size:.76rem; }
  .latest-card h3 { margin:.4rem 0 .7rem; font-size:1.4rem; }
  .latest-card p { color:var(--muted); font-size:.88rem; }
  .latest-card strong { display:block; margin-top:1rem; color:var(--accent); font-size:.8rem; }
  .section-grid-new { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .section-entry { display:grid; grid-template-columns:60px minmax(0,1fr); gap:1rem; min-height:250px; padding:1.7rem; border:1px solid var(--line); border-radius:20px; background:var(--surface); color:inherit; text-decoration:none; }
  .section-entry > span { color:var(--accent); font:500 2.6rem/1 Georgia,serif; }
  .section-entry p { margin:0; color:var(--accent); font-size:.7rem; font-weight:850; letter-spacing:.12em; text-transform:uppercase; }
  .section-entry h3 { margin:.35rem 0 .7rem; font-size:2rem; }
  .section-entry strong { display:block; color:var(--muted); font-weight:400; }
  .section-entry b { display:block; margin-top:1.2rem; color:var(--accent); font-size:.82rem; }
  .home-subscribe { display:flex; align-items:center; justify-content:space-between; gap:2rem; margin-bottom:6rem; padding:clamp(2rem,5vw,3.5rem); border-radius:22px; background:var(--accent-soft); }
  .home-subscribe h2 { margin:0; font-size:clamp(2rem,5vw,3.6rem); }
  .home-subscribe p:not(.kicker) { color:var(--muted); }
  .home-subscribe > a { flex:0 0 auto; border-radius:999px; background:var(--accent); color:white; padding:.8rem 1.2rem; font-weight:800; text-decoration:none; }
  @media(max-width:900px) { .latest-grid { grid-template-columns:1fr; } }
  @media(max-width:760px) { .home-hero,.section-head { grid-template-columns:1fr; } .section-head > a { justify-self:start; } .section-grid-new { grid-template-columns:1fr; } .home-subscribe { align-items:flex-start; flex-direction:column; } }
</style>
