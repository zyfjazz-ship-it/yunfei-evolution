---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionCard from "../../components/SectionCard.astro";
import { copy, site, type Language } from "../../config/site";
import { sections } from "../../config/sections";

export function getStaticPaths() {
  return ["zh", "en"].map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const base = import.meta.env.BASE_URL;
const path = (value: string) => `${base}${value.replace(/^\//, "")}`;
---

<BaseLayout lang={lang} alternatePath="/">
  <section class="hero shell">
    <p class="eyebrow">{site.author}</p>
    <h1>{site.name}</h1>
    <p class="hero-line">{site.description}</p>
    <p class="hero-intro">{copy[lang].intro}</p>
  </section>

  <section class="section-grid shell" aria-label={lang === "zh" ? "网站板块" : "Site sections"}>
    {sections.map((section) => (
      <SectionCard
        title={section.title[lang]}
        description={section.description[lang]}
        active={section.active}
        label={section.id === "blog" ? copy[lang].allPosts : lang === "zh" ? "进入查看" : "Explore"}
        href={section.href ? path(`${lang}${section.href}`) : undefined}
      />
    ))}
  </section>

  <section class="subscribe-callout shell" aria-labelledby="home-subscribe-title">
    <div>
      <p class="eyebrow">Newsletter</p>
      <h2 id="home-subscribe-title">{lang === "zh" ? "订阅云非的进化论" : "Subscribe to Yunfei's Evolution"}</h2>
      <p>{lang === "zh" ? "订阅入口已经预留，未来可接入 Newsletter 服务。" : "The subscription entry is ready for a future newsletter service."}</p>
    </div>
    <a class="button-link" href={path(`${lang}/subscribe/`)}>{lang === "zh" ? "前往订阅" : "Subscribe"} →</a>
  </section>
</BaseLayout>
