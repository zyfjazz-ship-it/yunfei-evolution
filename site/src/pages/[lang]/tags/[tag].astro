---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { copy, type Language } from "../../../config/site";
import { postSlug, sortPosts, tagSlug } from "../../../utils/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const paths = new Map<string, { lang: Language; tag: string }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      paths.set(`${post.data.lang}:${tagSlug(tag)}`, { lang: post.data.lang, tag });
    }
  }
  return [...paths.values()].map(({ lang, tag }) => ({
    params: { lang, tag: tagSlug(tag) },
    props: { lang, tag },
  }));
}

const { lang, tag } = Astro.props as { lang: Language; tag: string };
const posts = sortPosts(await getCollection("blog", ({ data }) =>
  data.lang === lang && !data.draft && data.tags.includes(tag)
));
const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) => new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en", {
  year: "numeric", month: "long", day: "numeric",
}).format(date);
---

<BaseLayout lang={lang} title={`${lang === "zh" ? "标签" : "Tag"}: ${tag}`} alternatePath="/blog/">
  <header class="page-heading shell">
    <p class="eyebrow">{lang === "zh" ? "标签" : "Tag"}</p>
    <h1>#{tag}</h1>
    <p>{lang === "zh" ? `${posts.length} 篇相关文章` : `${posts.length} related ${posts.length === 1 ? "post" : "posts"}`}</p>
  </header>
  <section class="tag-posts shell">
    <ul>
      {posts.map((post) => <li>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <h2><a href={`${base}${lang}/blog/${postSlug(post)}/`}>{post.data.title}</a></h2>
      </li>)}
    </ul>
    <a class="text-link" href={`${base}${lang}/blog/`}>← {copy[lang].allPosts}</a>
  </section>
</BaseLayout>
