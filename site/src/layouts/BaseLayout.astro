---
import "../styles/global.css";
import { site, copy, type Language } from "../config/site";

interface Props {
  lang: Language;
  title?: string;
  description?: string;
  alternatePath?: string;
}

const {
  lang,
  title = site.name,
  description = site.description,
  alternatePath = "/",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const path = (value: string) => `${base}${value.replace(/^\//, "")}`;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title === site.name ? title : `${title} · ${site.name}`}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={path(`${lang}/`)}>{site.name}</a>
        <nav aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
          <a href={path(`${lang}/blog/`)}>Blog</a>
          <a href={path(`${lang}/courses/`)}>{copy[lang].courses}</a>
          <a href={path(`${lang}/works/`)}>{copy[lang].works}</a>
          <a href={path(`${lang}/showcase/`)}>{copy[lang].showcase}</a>
          <a href={path(`${lang}/subscribe/`)}>{copy[lang].subscribe}</a>
          <span class="language-switch" aria-label={lang === "zh" ? "选择语言" : "Choose language"}>
            <a href={path(`zh${lang === "zh" ? Astro.url.pathname.replace(base, "/").replace(/^\/zh/, "") : alternatePath}`)} aria-current={lang === "zh" ? "page" : undefined}>中文</a>
            <span aria-hidden="true">|</span>
            <a href={path(`en${lang === "en" ? Astro.url.pathname.replace(base, "/").replace(/^\/en/, "") : alternatePath}`)} aria-current={lang === "en" ? "page" : undefined}>English</a>
          </span>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">© {new Date().getFullYear()} {site.author}</div>
    </footer>
  </body>
</html>
