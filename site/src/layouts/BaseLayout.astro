---
import "../styles/global.css";
import { site, copy, type Language } from "../config/site";

interface Props {
  lang: Language;
  title?: string;
  description?: string;
  alternatePath?: string;
}

const {
  lang,
  title = site.name,
  description = site.description,
  alternatePath = "/",
} = Astro.props;
const otherLang: Language = lang === "zh" ? "en" : "zh";
const base = import.meta.env.BASE_URL;
const path = (value: string) => `${base}${value.replace(/^\//, "")}`;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title === site.name ? title : `${title} · ${site.name}`}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={path(`${lang}/`)}>{site.name}</a>
        <nav aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
          <a href={path(`${lang}/blog/`)}>Blog</a>
          <a class="language-switch" href={path(`${otherLang}${alternatePath}`)}>{copy[lang].switchLanguage}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">© {new Date().getFullYear()} {site.author}</div>
    </footer>
  </body>
</html>
