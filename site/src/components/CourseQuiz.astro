---
interface QuizQuestion {
  prompt: string;
  options: string[];
  answer: number;
  explanation: string;
}

interface Quiz {
  questions: QuizQuestion[];
  reflectionPrompt: string;
  submitLabel?: string;
}

const { quiz, lang = "zh" } = Astro.props as { quiz: Quiz; lang?: "zh" | "en" };
const isZh = lang === "zh";
---

<section class="course-quiz" data-course-quiz aria-labelledby="course-quiz-title">
  <header>
    <p>{isZh ? "Lesson check" : "Lesson check"}</p>
    <h2 id="course-quiz-title">{isZh ? "完成本课练习" : "Complete the lesson check"}</h2>
    <span>{isZh ? "选择答案，再用自己的话写下理解。内容只在当前页面处理，不会上传或公开。" : "Choose your answers and explain your reasoning. Your responses stay on this page and are not uploaded or published."}</span>
  </header>

  <form>
    {quiz.questions.map((question, questionIndex) => (
      <fieldset data-answer={question.answer} data-explanation={question.explanation}>
        <legend>{questionIndex + 1}. {question.prompt}</legend>
        <div class="quiz-options">
          {question.options.map((option, optionIndex) => (
            <label class="quiz-option">
              <input type="radio" name={`question-${questionIndex}`} value={optionIndex} />
              <span><b>{String.fromCharCode(65 + optionIndex)}</b>{option}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}

    <label class="reflection-field">
      <span>{quiz.reflectionPrompt}</span>
      <textarea name="reflection" rows="5" placeholder={isZh ? "写下你的理解……" : "Write your explanation…"} required></textarea>
    </label>

    <button type="submit">{quiz.submitLabel ?? (isZh ? "提交答案" : "Submit answers")}</button>
    <div class="quiz-feedback" aria-live="polite"></div>
  </form>
</section>

<script>
  document.querySelectorAll("[data-course-quiz]").forEach((quizRoot) => {
    if (quizRoot.getAttribute("data-ready") === "true") return;
    quizRoot.setAttribute("data-ready", "true");

    const form = quizRoot.querySelector("form");
    const feedback = quizRoot.querySelector(".quiz-feedback");
    if (!form || !feedback) return;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const fieldsets = Array.from(form.querySelectorAll("fieldset"));
      const reflection = form.querySelector("textarea");
      const unanswered = fieldsets.some((fieldset) => !fieldset.querySelector("input:checked"));

      if (unanswered || !reflection || !reflection.value.trim()) {
        feedback.replaceChildren();
        feedback.classList.add("is-error");
        feedback.textContent = "请完成所有选择题，并写下自己的理解。";
        return;
      }

      feedback.classList.remove("is-error");
      let score = 0;
      const answerList = document.createElement("ol");

      fieldsets.forEach((fieldset) => {
        const checked = fieldset.querySelector("input:checked");
        const selected = Number(checked?.getAttribute("value"));
        const answer = Number(fieldset.getAttribute("data-answer"));
        const explanation = fieldset.getAttribute("data-explanation") || "";
        const item = document.createElement("li");
        const correct = selected === answer;
        if (correct) score += 1;
        item.textContent = `${correct ? "回答正确" : `正确答案是 ${String.fromCharCode(65 + answer)}`}。${explanation}`;
        answerList.appendChild(item);
      });

      const heading = document.createElement("strong");
      heading.textContent = `选择题得分：${score}/${fieldsets.length}`;
      const note = document.createElement("p");
      note.textContent = "文字回答不判对错，只保留在当前输入框中，不会上传或公开。";
      feedback.replaceChildren(heading, answerList, note);
      feedback.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  });
</script>

<style>
  .course-quiz { margin-top: 4rem; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); padding: clamp(1.4rem, 4vw, 2.4rem); font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .course-quiz header { padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
  .course-quiz header p { margin: 0 0 .4rem; color: var(--track); font-size: .72rem; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
  .course-quiz header h2 { margin: 0; color: var(--text); font-family: "Songti SC", "STSong", Georgia, serif; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .course-quiz header span { display: block; margin-top: .7rem; color: var(--muted); font-size: .9rem; line-height: 1.6; }
  .course-quiz form { display: grid; gap: 2rem; margin-top: 2rem; }
  .course-quiz fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .course-quiz legend { margin-bottom: .9rem; font-family: "Songti SC", "STSong", Georgia, serif; font-size: 1.08rem; font-weight: 700; line-height: 1.65; }
  .quiz-options { display: grid; gap: .65rem; }
  .quiz-option { display: flex; align-items: flex-start; gap: .75rem; border: 1px solid var(--line); border-radius: 12px; padding: .8rem 1rem; color: var(--text); font-size: .9rem; line-height: 1.55; cursor: pointer; transition: border-color .18s ease, background .18s ease; }
  .quiz-option:hover { border-color: var(--track); }
  .quiz-option:has(input:checked) { border-color: var(--track); background: var(--track-soft); }
  .quiz-option input { flex: 0 0 auto; margin-top: .28rem; accent-color: var(--track); }
  .quiz-option span { display: flex; gap: .65rem; }
  .quiz-option b { color: var(--track); }
  .reflection-field { display: grid; gap: .65rem; font-family: "Songti SC", "STSong", Georgia, serif; font-size: 1.05rem; font-weight: 700; }
  .reflection-field textarea { width: 100%; box-sizing: border-box; resize: vertical; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); padding: .9rem 1rem; color: var(--text); font: 400 .95rem/1.65 Inter, ui-sans-serif, system-ui, sans-serif; }
  .reflection-field textarea:focus { border-color: var(--track); outline: 2px solid var(--track-soft); outline-offset: 2px; }
  .course-quiz button { justify-self: start; border: 0; border-radius: 999px; background: var(--track); padding: .75rem 1.25rem; color: white; font: 800 .86rem/1 Inter, ui-sans-serif, system-ui, sans-serif; cursor: pointer; }
  .course-quiz button:hover { filter: brightness(.94); }
  .quiz-feedback:empty { display: none; }
  .quiz-feedback { border-top: 1px solid var(--line); padding-top: 1.3rem; font-size: .88rem; line-height: 1.65; }
  .quiz-feedback strong { color: var(--track); font-size: 1rem; }
  .quiz-feedback ol { padding-left: 1.2rem; }
  .quiz-feedback p { margin-bottom: 0; color: var(--muted); }
  .quiz-feedback.is-error { color: #a33b2b; }
  @media (max-width: 520px) {
    .course-quiz { border-radius: 16px; }
    .quiz-option { padding: .75rem .8rem; }
    .course-quiz button { width: 100%; }
  }
</style>
