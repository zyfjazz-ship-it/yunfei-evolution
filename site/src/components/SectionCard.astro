---
interface Props {
  title: string;
  description: string;
  href?: string;
  active: boolean;
  label: string;
}

const { title, description, href, active, label } = Astro.props;
---

<article class:list={["section-card", { muted: !active }]}>
  <p class="eyebrow">{active ? label : "Coming later"}</p>
  <h2>{title}</h2>
  <p>{description}</p>
  {active && href && <a class="text-link" href={href}>{label} →</a>}
</article>
